{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "defaultMode": "acceptEdits",
        "deny": [
            "Bash(npm publish*)",
            "Bash(pnpm publish*)",
            "Read(.env)",
            "Read(.env.*)",
            "Read(**/*.pem)"
        ],
        "ask": [
            "Bash(git push *)",
            "Bash(pnpm add *)",
            "Edit(.claude/**)"
        ],
        "allow": [
            "Bash(pnpm test *)",
            "Bash(pnpm check)",
            "Bash(pnpm -r check)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git status *)"
        ]
    },
    "attribution": {
        "commit": "",
        "pr": "🤖 Generated with [Claude Code](https://claude.com/claude-code)"
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_commands.py\""
                    },
                    {
                        "type": "command",
                        "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify_before_commit.py\""
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_changed.py\""
                    }
                ]
            }
        ]
    }
}
